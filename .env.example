# ============================================================
# Flashcards — variáveis de ambiente
# Copie para .env.local (dev). Toda variável NOVA deve ser
# documentada aqui no MESMO PR (gate transversal do plano).
# ============================================================

# --- Banco (3 connection strings, 3 roles distintos — ver §6.1) ---
# Owner: SÓ migrations (pnpm db:migrate) e drizzle-kit. Nunca no runtime.
DATABASE_URL_OWNER=postgres://flashcards_owner:senha@localhost:5432/flashcards
# App: runtime com RLS. Usada por web e worker via withUserTransaction.
DATABASE_URL_APP=postgres://flashcards_app:senha@localhost:5432/flashcards
# Service: adapter Auth.js + jobs de sistema (BYPASSRLS restrito).
DATABASE_URL_SERVICE=postgres://flashcards_service:senha@localhost:5432/flashcards

# Orçamento de conexões (teto agregado do app <= 15 — aceite F7).
# Web: app 6 + service 2. Worker (F2+): app 2 + service 2 + pg-boss 5.
DATABASE_POOL_MAX_APP=6
DATABASE_POOL_MAX_SERVICE=2

# --- Auth.js (web) ---
# Gerar com: openssl rand -base64 32
AUTH_SECRET=
# Atrás do Nginx/Cloudflare (produção): confiar no X-Forwarded-Host.
AUTH_TRUST_HOST=true
# Produção (explícita; dev deriva de localhost:3060):
# AUTH_URL=https://flashcards.mnrs.com.br
# Google OAuth (GCP Console; redirect: <origin>/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Mídia / Object Storage (Fase 2) ---
# Driver ativo: "local" (filesystem do servidor — fallback documentado; sem API
# key Magalu ainda, débito) ou "s3" (Magalu Object Storage, presigned PUT/GET).
# Web e worker precisam do MESMO valor e, no driver local, do MESMO diretório.
STORAGE_DRIVER=local
# Diretório do driver local (relativo ao cwd do processo ou absoluto).
STORAGE_LOCAL_DIR=.data/media
# Limite de upload em bytes (default 10485760 = 10 MB).
MEDIA_MAX_BYTES=10485760
# Driver s3 (Magalu; criar API key em id.magalu.com com escopo Object Storage):
# MAGALU_S3_ENDPOINT=https://br-se1.magaluobjects.com
# MAGALU_S3_REGION=br-se1
# MAGALU_S3_BUCKET=
# MAGALU_S3_ACCESS_KEY_ID=
# MAGALU_S3_SECRET_ACCESS_KEY=

# --- Worker (Fase 2; processo PM2 separado, mesmo build) ---
# Pool próprio do pg-boss no worker (além de app 2 + service 2).
# WORKER_PGBOSS_POOL_MAX=5

# --- Testes (CI/dev; não usado em produção) ---
# Superusuário local para criar bancos descartáveis de teste.
# Local (Homebrew): postgres://SEU_USUARIO@localhost:5432/postgres
# CI: postgres://postgres:postgres@127.0.0.1:5432/postgres
# TEST_ADMIN_DATABASE_URL=
